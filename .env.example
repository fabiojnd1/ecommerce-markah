# ==========================================
# ECOMMERCE MARKAH — VARIÁVEIS DE AMBIENTE
# ==========================================
# Copie este arquivo para .env.local em ambiente de desenvolvimento local:
# cp .env.example .env.local

# ------------------------------------------
# 1. BANCO DE DADOS (PostgreSQL / Neon)
# ------------------------------------------
# String de conexão com pooling para consultas na aplicação
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"
# Conexão direta sem pooling para migrações do Prisma (prisma migrate)
DIRECT_URL="postgresql://user:password@ep-sample.us-east-1.aws.neon.tech/neondb?sslmode=require"

# ------------------------------------------
# 2. AUTENTICAÇÃO (sessões próprias assinadas — D-017)
# ------------------------------------------
# Chave que assina os cookies de sessão e os links mágicos. OBRIGATÓRIA em produção.
# Gere com: openssl rand -base64 32
AUTH_SECRET="gerar-chave-com-openssl-rand-base64-32"
# Login do painel /admin. Em produção, sem estas variáveis o login fica bloqueado.
# (Em desenvolvimento, sem elas, vale admin@markah.com.br / markah2026.)
ADMIN_EMAIL="seu-email@markah.com.br"
ADMIN_PASSWORD="troque-por-uma-senha-longa-e-unica"

# ------------------------------------------
# 3. PAGAMENTOS (Mercado Pago)
# ------------------------------------------
# Obter no painel do Mercado Pago Developers (credenciais de teste para dev/preview)
# Public key usada pelo Card Payment Brick no navegador (precisa do prefixo NEXT_PUBLIC_)
NEXT_PUBLIC_MERCADO_PAGO_PUBLIC_KEY="TEST-00000000-0000-0000-0000-000000000000"
MERCADO_PAGO_ACCESS_TOKEN="TEST-0000000000000000-000000-00000000000000000000000000000000-000000000"
# Chave secreta do webhook (Suas integrações > Webhooks). OBRIGATÓRIA em produção:
# sem ela o webhook recusa todas as notificações.
MERCADO_PAGO_WEBHOOK_SECRET="seu-webhook-secret"

# ------------------------------------------
# 4. FRETE (Melhor Envio)
# ------------------------------------------
# Token gerado no painel do Melhor Envio (Sandbox em dev/preview, Produção em produção)
MELHOR_ENVIO_TOKEN="seu-token-melhor-envio"
MELHOR_ENVIO_SANDBOX="true"
# CEP de envio da Markah Brasil (origem do frete)
ORIGIN_POSTAL_CODE="01001000"

# ------------------------------------------
# 5. E-MAILS (Resend)
# ------------------------------------------
RESEND_API_KEY="re_123456789"
EMAIL_FROM="Markah Brasil <contato@markah.com.br>"

# ------------------------------------------
# 6. ARMAZENAMENTO DE IMAGENS (Vercel Blob)
# ------------------------------------------
# Preferência de armazenamento: "database" (salva no PostgreSQL) ou "blob" (Vercel Blob)
IMAGE_STORAGE_PREFERENCE="database"
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_0000000000000000000000"

# ------------------------------------------
# 7. CONTATO E CONFIGURAÇÃO DA LOJA
# ------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_WHATSAPP_NUMBER="5511999999999"
NEXT_PUBLIC_INSTAGRAM_USER="markah_br"

# ------------------------------------------
# 8. DADOS DE DEMONSTRAÇÃO (somente no seu computador)
# ------------------------------------------
# Permite `npm run build && npm start` sem banco de dados, usando o catálogo de exemplo.
# NUNCA defina na Vercel em produção. Pagamentos nunca são simulados em produção.
# ALLOW_DEMO_DATA="true"
