datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  AGUARDANDO_PAGAMENTO
  PAGO
  EM_PRODUCAO
  PRONTO_PARA_ENVIO
  ENVIADO
  ENTREGUE
  CANCELADO
  PAGAMENTO_RECUSADO
  REEMBOLSADO
}

enum PaymentMethod {
  PIX
  CREDIT_CARD
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
  REFUNDED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(CUSTOMER)
  phone         String?
  cpf           String?   @unique

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  addresses     Address[]
  orders        Order[]

  @@map("users")
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String? @db.Text
  access_token       String? @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String? @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model StoreSettings {
  id                         String   @id @default("default")
  storeName                  String   @default("Markah Brasil")
  whatsappNumber             String   @default("5511999999999")
  instagramHandle            String   @default("markah_br")
  originPostalCode           String   @default("01001000")
  pixDiscountPercent         Int      @default(5) // Em porcentagem inteira: 5%
  maxInstallmentsFree        Int      @default(3) // 3x sem juros
  freeShippingThresholdCents Int      @default(20000) // R$ 200,00 em centavos (D-011)
  defaultProductionDays      Int      @default(3) // 3 dias úteis

  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  @@map("store_settings")
}

// ==========================================
// MODELOS DO CATÁLOGO DE PRODUTOS (FASE 1)
// ==========================================

model Category {
  id           String    @id @default(cuid())
  name         String
  slug         String    @unique
  description  String?   @db.Text
  imageUrl     String?
  displayOrder Int       @default(0)
  active       Boolean   @default(true)

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  products     Product[]

  @@map("categories")
}

model Collection {
  id           String              @id @default(cuid())
  name         String
  slug         String              @unique
  description  String?             @db.Text
  imageUrl     String?
  displayOrder Int                 @default(0)
  active       Boolean             @default(true)

  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  products     ProductCollection[]

  @@map("collections")
}

model Product {
  id              String              @id @default(cuid())
  name            String
  slug            String              @unique
  description     String              @db.Text
  status          ProductStatus       @default(ACTIVE)
  material        String              @default("PLA") // PLA ou PETG
  isSustainable   Boolean             @default(false)
  productionDays  Int                 @default(3)

  // Ficha técnica
  dimensions      String?             // ex: "22 × 18 × 18 cm"
  weightGrams     Int?                // ex: 350g
  socketType      String?             // ex: "E27" (para luminárias)
  maxWattage      Int?                // ex: 15 (Watts)
  bulbIncluded    Boolean             @default(false)
  cordLengthCm    Int?                // ex: 150 (cm)
  waterproof      Boolean             @default(false) // para vasos

  // SEO
  seoTitle        String?
  seoDescription  String?             @db.Text

  categoryId      String
  category        Category            @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  images          ProductImage[]
  options         ProductOption[]
  variants        ProductVariant[]
  collections     ProductCollection[]
  orderItems      OrderItem[]

  @@map("products")
}

model ProductCollection {
  productId    String
  collectionId String

  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@id([productId, collectionId])
  @@map("product_collections")
}

model ProductImage {
  id           String   @id @default(cuid())
  productId    String
  url          String
  alt          String
  displayOrder Int      @default(0)
  isPrimary    Boolean  @default(false)
  isHover      Boolean  @default(false) // Foto acesa ou ambientada para troca no hover

  createdAt    DateTime @default(now())

  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_images")
}

model ProductOption {
  id           String               @id @default(cuid())
  productId    String
  name         String               // ex: "Cor", "Tamanho", "Textura"
  displayOrder Int                  @default(0)

  product      Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  values       ProductOptionValue[]

  @@map("product_options")
}

model ProductOptionValue {
  id           String                      @id @default(cuid())
  optionId     String
  name         String                      // ex: "Terracota", "Branco Pérola", "Médio"
  colorHex     String?                     // ex: "#C05A3E" para renderizar bolinhas de amostra
  displayOrder Int                         @default(0)

  option       ProductOption               @relation(fields: [optionId], references: [id], onDelete: Cascade)
  variants     ProductVariantOptionValue[]

  @@map("product_option_values")
}

model ProductVariant {
  id                  String                      @id @default(cuid())
  productId           String
  sku                 String                      @unique
  priceCents          Int                         // Preço normal em centavos (D-011)
  compareAtPriceCents Int?                        // Preço "de" em centavos (promocional)
  
  // Parâmetros de frete / embalagem (P-006: obrigatório para Melhor Envio)
  weightGrams         Int                         @default(400)
  packageHeightCm     Int                         @default(20)
  packageWidthCm      Int                         @default(20)
  packageDepthCm      Int                         @default(20)

  active              Boolean                     @default(true)
  imageUrl            String?

  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt

  product             Product                     @relation(fields: [productId], references: [id], onDelete: Cascade)
  optionValues        ProductVariantOptionValue[]
  orderItems          OrderItem[]

  @@map("product_variants")
}

model ProductVariantOptionValue {
  id            String             @id @default(cuid())
  variantId     String
  optionValueId String

  variant       ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  optionValue   ProductOptionValue @relation(fields: [optionValueId], references: [id], onDelete: Cascade)

  @@unique([variantId, optionValueId])
  @@map("product_variant_option_values")
}

// ==========================================
// MODELOS DE PEDIDOS, ENDEREÇOS E CHECKOUT (FASE 4)
// ==========================================

model Address {
  id            String   @id @default(cuid())
  userId        String?
  recipientName String
  postalCode    String   // CEP (8 dígitos)
  street        String
  number        String
  complement    String?
  neighborhood  String
  city          String
  state         String   // UF (2 letras)
  isDefault     Boolean  @default(false)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("addresses")
}

model Order {
  id                         String        @id @default(cuid())
  orderNumber                String        @unique // Ex: MKB-00101
  userId                     String?
  customerName               String
  customerEmail              String
  customerPhone              String
  customerCpf                String

  status                     OrderStatus   @default(AGUARDANDO_PAGAMENTO)

  // Valores financeiros em centavos inteiros (D-011)
  subtotalCents              Int
  couponCode                 String?
  couponDiscountCents        Int           @default(0)
  discountedSubtotalCents     Int
  shippingCarrier            String        // Ex: "Correios PAC", "Correios SEDEX"
  shippingPriceCents         Int
  shippingOriginalPriceCents Int
  isFreeShipping             Boolean       @default(false)
  carrierDays                Int
  productionDays             Int           @default(3)
  totalDeliveryDays          Int
  totalCents                 Int           // Total antes do desconto Pix
  pixDiscountAmountCents     Int           @default(0)
  finalAmountCents           Int           // Valor cobrado efetivamente no método

  // Pagamento (Mercado Pago)
  paymentMethod              PaymentMethod
  paymentStatus              PaymentStatus @default(PENDING)
  paymentId                  String?       // ID do Mercado Pago
  pixQrCode                  String?       @db.Text
  pixQrCodeUrl               String?       @db.Text
  pixExpiresAt               DateTime?
  cardBrand                  String?
  cardLastFour               String?
  cardInstallments           Int?

  // Endereço de entrega (snapshot imutável)
  shippingPostalCode         String
  shippingStreet             String
  shippingNumber             String
  shippingComplement         String?
  shippingNeighborhood       String
  shippingCity               String
  shippingState              String

  // Rastreio e Operação (Fase 5)
  trackingCode               String?
  internalNotes              String?       @db.Text
  shippedAt                  DateTime?
  deliveredAt                DateTime?

  createdAt                  DateTime      @default(now())
  updatedAt                  DateTime      @updatedAt

  user                       User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  items                      OrderItem[]

  @@index([paymentId])
  @@index([customerEmail])
  @@map("orders")
}

model OrderItem {
  id              String         @id @default(cuid())
  orderId         String
  productId       String
  variantId       String
  productName     String
  productSlug     String
  variantSku      String
  variantName     String
  colorHex        String?
  imageUrl        String
  unitPriceCents  Int            // Preço unitário em centavos (D-011)
  quantity        Int
  totalPriceCents Int            // unitPriceCents * quantity

  order           Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product         Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant         ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@map("order_items")
}

model WebhookEvent {
  id        String   @id @default(cuid())
  eventId   String   @unique // ID do evento ou payment ID processado (P-003)
  provider  String   @default("MERCADO_PAGO")
  eventType String
  processed Boolean  @default(true)
  payload   Json?
  createdAt DateTime @default(now())

  @@map("webhook_events")
}

enum CouponDiscountType {
  PERCENTAGE
  FIXED
  FREE_SHIPPING
}

model Coupon {
  id               String             @id @default(cuid())
  code             String             @unique
  type             CouponDiscountType @default(PERCENTAGE)
  value            Int                // Centavos para FIXED, percentual (1-100) para PERCENTAGE, 0 para FREE_SHIPPING
  description      String?
  minOrderCents    Int?               // Subtotal mínimo em centavos
  maxDiscountCents Int?               // Teto de desconto em centavos para percentual
  usageLimit       Int?               // Quantidade máxima total de utilizações
  usageCount       Int                @default(0)
  startDate        DateTime?
  endDate          DateTime?
  isPixCumulative  Boolean            @default(true)
  active           Boolean            @default(true)

  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@map("coupons")
}

model Review {
  id               String   @id @default(cuid())
  productId        String
  productName      String
  productSlug      String
  customerName     String
  customerEmail    String?
  rating           Int      @default(5) // 1 a 5
  title            String?
  comment          String   @db.Text
  verifiedPurchase Boolean  @default(true)
  status           String   @default("APPROVED") // PENDING, APPROVED, REJECTED

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("reviews")
}

model GalleryPost {
  id                String   @id @default(cuid())
  customerInstagram String?  // ex: "@studio.arquitetura"
  customerName      String
  imageUrl          String
  productSlug       String?
  productName       String?
  caption           String?
  approved          Boolean  @default(true)
  displayOrder      Int      @default(0)

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("gallery_posts")
}

// ==========================================
// ARMAZENAMENTO DE IMAGENS NO BANCO DE DADOS
// ==========================================

model StoredImage {
  id           String   @id @default(cuid())
  filename     String
  mimeType     String   // ex: "image/jpeg", "image/png"
  data         String   @db.Text // Base64 da imagem para persistência direta no PostgreSQL
  sizeBytes    Int
  width        Int?
  height       Int?

  createdAt    DateTime @default(now())

  @@map("stored_images")
}



